{
  "name": "project-health",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "collect": "pnpm --filter @project-health/collector run start",
    "facet-store": "pnpm --filter @project-health/collector run facet-store",
    "verify:config": "node scripts/check-projects.mjs",
    "test:config": "node --test scripts/check-projects.test.mjs",
    "web:dev": "pnpm --filter @project-health/web run dev",
    "web:build": "pnpm --filter @project-health/web run build",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.32",
      "source-map-js": ">=1.2.2"
    }
  }
}
