{
  "$schema": "./schema/projects.schema.json",
  "organization": "your-org",
  "projects": [
    {
      "id": "checkout",
      "name": "Checkout",
      "repo": "your-org/checkout",
      "type": "back-front",
      "enabled": true,
      "status": "production",
      "environments": {
        "production": "pro",
        "staging": "pre"
      },
      "productionRefPattern": "^v[0-9]+[.][0-9]+[.][0-9]+$",
      "workItemLabel": "implement",
      "reworkLabel": "hotfix",
      "reworkLabelPrecision": "incident",
      "agents": {
        "enabled": true,
        "workflow": ".github/workflows/work-router.yml"
      },
      "engineeringExcellence": {
        "enabled": true
      },
      "roadmap": {
        "enabled": true
      },
      "scorecard": {
        "performance": true
      },
      "notes": "Tag based releases and a dedicated hotfix label, so every metric including the stability axis is available."
    },
    {
      "id": "billing",
      "name": "Billing",
      "repo": "your-org/billing",
      "type": "back-front",
      "enabled": true,
      "status": "production",
      "environments": {
        "production": "production",
        "staging": null
      },
      "productionRefPattern": "^main$",
      "workItemLabel": null,
      "reworkLabel": "bug",
      "reworkLabelPrecision": "broad",
      "agents": {
        "enabled": true,
        "workflow": ".github/workflows/work-router.yml"
      },
      "engineeringExcellence": {
        "enabled": true
      },
      "notes": "Names its environment production rather than pro, deploys main rather than tags, and has no dedicated hotfix label. Every one of those is why these are configuration and not assumptions.",
      "roadmap": {
        "enabled": true
      }
    },
    {
      "id": "mobile",
      "name": "Mobile",
      "repo": "your-org/mobile",
      "type": "mobile",
      "enabled": true,
      "status": "pre-production",
      "environments": {
        "production": null,
        "staging": "pre"
      },
      "productionRefPattern": "^v[0-9]+[.][0-9]+[.][0-9]+$",
      "workItemLabel": null,
      "reworkLabel": "bug",
      "reworkLabelPrecision": "broad",
      "agents": {
        "enabled": true,
        "workflow": ".github/workflows/work-router.yml"
      },
      "engineeringExcellence": {
        "enabled": true
      },
      "notes": "Ships to staging but not yet to production, so production metrics are skipped rather than reported as zero.",
      "roadmap": {
        "enabled": true
      }
    },
    {
      "id": "ledger",
      "name": "Ledger",
      "repo": "your-org/ledger",
      "type": "library",
      "enabled": true,
      "status": "production",
      "environments": {
        "production": null,
        "staging": null
      },
      "productionRefPattern": "^v[0-9]+[.][0-9]+[.][0-9]+$",
      "workItemLabel": null,
      "reworkLabel": "bug",
      "reworkLabelPrecision": "broad",
      "agents": {
        "enabled": true,
        "workflow": ".github/workflows/work-router.yml"
      },
      "engineeringExcellence": {
        "enabled": true
      },
      "notes": "A library: it publishes packages instead of deploying, so delivery metrics are skipped, and the engineering scorecard and the agents carry it.",
      "roadmap": {
        "enabled": true
      }
    }
  ]
}
